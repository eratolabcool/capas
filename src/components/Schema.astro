---
export interface Props {
  type?: 'organization' | 'service' | 'faq';
}

const { type = 'organization' } = Astro.props;

const schemas = {
  organization: {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'CapasPro',
    description: 'Capas personalizadas para mobiliário exterior, hotéis, restaurantes e equipamentos.',
  },
  service: {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Capas exteriores personalizadas',
    serviceType: 'Produção de capas à medida',
    description: 'Soluções de proteção exterior personalizadas contra chuva, sol e humidade.',
    areaServed: 'Portugal',
  },
  faq: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [],
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemas[type])} />
