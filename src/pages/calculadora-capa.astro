---
const title = 'Calculadora de Capa Personalizada | Capas à Medida';
---
<html lang="pt-PT">
<head>
<title>{title}</title>
<meta name="description" content="Calcule uma estimativa para a sua capa personalizada. Envie medidas e fotografias para receber um orçamento." />
</head>
<body>
<header>
<h1>Calculadora de Capa Personalizada</h1>
<p>Indique as medidas do seu equipamento exterior e receba uma proposta personalizada.</p>
</header>
<main>
<form>
<label>Tipo de produto</label>
<select>
<option>Sofá exterior</option>
<option>Mobiliário de jardim</option>
<option>Churrasqueira</option>
<option>Equipamento exterior</option>
</select>
<label>Comprimento (cm)</label>
<input type="number" />
<label>Largura (cm)</label>
<input type="number" />
<label>Altura (cm)</label>
<input type="number" />
<label>Material pretendido</label>
<select>
<option>Oxford 420D</option>
<option>Oxford 600D</option>
<option>PVC impermeável</option>
</select>
<label>Email ou WhatsApp</label>
<input type="text" />
<button>Pedir orçamento</button>
</form>
</main>
</body>
</html>