---
const title = 'Pedir Orçamento de Capa Personalizada';
---
<html lang="pt-PT">
<head><title>{title}</title><meta name="description" content="Envie medidas e fotografias para receber uma proposta personalizada." /></head>
<body>
<header><h1>{title}</h1><p>Receba uma proposta para a sua capa feita à medida.</p></header>
<main>
<form>
<label>Tipo de produto</label><input name="produto" />
<label>Dimensões</label><input name="medidas" />
<label>Email</label><input type="email" name="email" />
<label>Mensagem</label><textarea name="mensagem"></textarea>
<button>Enviar pedido</button>
</form>
</main>
</body>
</html>